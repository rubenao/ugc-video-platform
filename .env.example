# Replicate API - https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# OpenAI API (opcional) - https://platform.openai.com/api-keys
# Si se configura, GPT-4o-mini genera los prompts de avatar automáticamente
# Si no se configura, se usa una plantilla automática igualmente
OPENAI_API_KEY=your_openai_key_here

# ElevenLabs API - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Kie AI API - https://kie.ai (optional, para proveedor alternativo de video)
KIE_API_KEY=your_kie_api_key_here

# Proveedor de video: "replicate" (SadTalker) o "kie" (Kie Talking Photo)
VIDEO_PROVIDER=replicate

# SadTalker model version en Replicate (verificar versión actual en replicate.com/cjwbw/sadtalker)
SADTALKER_VERSION=3aa3dac9353cc4d6bd62a8f95957bd844003b401ca4e4a9b33baa574c549d376

PORT=3000
